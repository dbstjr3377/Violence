# ─────────────────────────────────────────────────────────────
#  VIOLENCE - 알림 메시지 (채팅에 띄우지 않고 서버 콘솔에만 남김)
# ─────────────────────────────────────────────────────────────

options:
	prefix: &d&l[VIOLENCE]&r

function violenceAnnounceStart(map: text, players: text, npcs: text, kills: text, seconds: text):
	set {_sec} to {_seconds} parsed as integer
	set {_min} to floor(({_sec} ? 600) / 60)
	send "{@prefix} &f맵 &e%{_map}% &7| &f플레이어 &e%{_players}% &7+ &fNPC &e%{_npcs}%" to console
	send "{@prefix} &f목표 &c%{_kills}%킬 &7| &f제한 시간 &e%{_min}%분" to console
	send "&7  왼클릭 사용 · 우클릭 던지기/줍기 · Space 처형/발차기 · 연속 3/5킬 시 E 로 가면 선택" to console

function violenceAnnounceStreak(name: text, streak: text):
	if {_streak} is "3":
		send "{@prefix} &e%{_name}% &f님이 &c연속 3킬&f! 가면을 쓸 수 있습니다." to console
	else:
		send "{@prefix} &e%{_name}% &f님이 &4&l연속 %{_streak}%킬&f! 피에 굶주렸습니다." to console

function violenceAnnounceEnd(winner: text, kills: text):
	send "&8&m                                        " to console
	send "{@prefix} &f&l게임 종료!  &f우승: &e&l%{_winner}% &7(%{_kills}%킬)" to console
	send "&8&m                                        " to console
