# ─────────────────────────────────────────────────────────────
#  VIOLENCE - 컷씬 다이얼로그 (핫라인 마이애미 2 대화 연출)
#
#  게임과 별개인 진행 연출입니다. 게임이 진행 중일 때는 시작되지 않습니다(로비에서 실행).
#  시작하면 모든 플레이어가 카메라 시점으로 고정되고, 어드민의 왼클릭으로 대사를 넘깁니다.
#    - 타자 중에 왼클릭: 대사 전체 표시
#    - 대사가 다 나온 뒤 왼클릭: 다음 대사 (마지막 대사였으면 컷씬 종료)
#
#  /컷씬 [이름]     컷씬 시작 (기본: intro)
#  /컷씬 다음       대사 넘기기 (왼클릭과 같음)
#  /컷씬 끝         컷씬 바로 끝내기
#
#  새 컷씬 만들기: 아래 violenceCutsceneIntro 처럼 함수를 만들고 /컷씬 명령어에 이름을 추가하세요.
#    violenceCutsceneLine(대상 개체, 초상화, 대사)
#      대상 개체: 카메라가 비출 개체 (플레이어, 아머스탠드, 몹 등)
#      초상화: 가면 이름(richard, tony, rasmus 없음 → unknown 등), npc, unknown,
#             또는 tools/portraits/<이름>.png 로 추가한 그림 이름
#      대사: 두 줄까지. \n 으로 줄을 직접 나눌 수 있습니다.
#    violenceCutsceneNarration(초상화, 대사)   카메라를 옮기지 않는 대사
#    violenceCutsceneActor(이름, 가면, 앞, 오른쪽, 각도)   어드민 앞에 임시 배우를 세움 (컷씬이 끝나면 사라짐)
#    violenceCutsceneActorLine(이름, 초상화, 대사)        그 배우를 비추며 대사
#  참고: 관전 중인 플레이어는 다른 사람 화면에 보이지 않으므로, 대화하는 인물은 배우(또는 NPC·아머스탠드)로 세우세요.
# ─────────────────────────────────────────────────────────────

options:
	prefix: &d&l[VIOLENCE]&r

command /컷씬 [<text>]:
	permission: violence.admin
	permission message: &c이 명령어를 사용할 권한이 없습니다.
	description: 컷씬 다이얼로그를 시작하거나 넘깁니다.
	usage: &e/컷씬 [이름 | 다음 | 끝]
	executable by: players
	trigger:
		set {_name} to arg-1 ? "intro"
		if {_name} is "다음" or "next":
			execute console command "violence cutscene next"
			stop
		if {_name} is "끝" or "end":
			execute console command "violence cutscene end"
			stop
		if {_name} is not "intro":
			send "{@prefix} &c없는 컷씬입니다: &e%{_name}% &7(사용 가능: intro)" to player
			stop
		execute console command "violence cutscene begin %player%"
		violenceCutsceneIntro(player)

# 카메라가 대상 개체를 비추며 대사 출력
function violenceCutsceneLine(target: entity, portrait: text, line: text):
	execute console command "violence cutscene say %uuid of {_target}% %{_portrait}% %{_line}%"

# 임시 배우 세우기: 어드민이 바라보는 방향 기준 앞 forward, 오른쪽 side 블록, 바라보는 각도 facing(도)
function violenceCutsceneActor(id: text, mask: text, forward: number, side: number, facing: number):
	execute console command "violence cutscene actor %{_id}% %{_mask}% %{_forward}% %{_side}% %{_facing}%"

# 배우를 비추며 대사
function violenceCutsceneActorLine(id: text, portrait: text, line: text):
	execute console command "violence cutscene say actor:%{_id}% %{_portrait}% %{_line}%"

# 카메라를 옮기지 않는 대사 (해설 등)
function violenceCutsceneNarration(portrait: text, line: text):
	execute console command "violence cutscene say none %{_portrait}% %{_line}%"

# 예시 컷씬: 어드민 앞 4블록에 배우 두 명(닭 가면, 정장)을 마주 보게 세우고 번갈아 대화
function violenceCutsceneIntro(admin: player):
	violenceCutsceneActor("rooster", "richard", 4, -1.3, 90)
	violenceCutsceneActor("suit", "none", 4, 1.3, -90)
	violenceCutsceneActorLine("rooster", "richard", "오늘 밤 손님이 많군. 준비는 됐나?")
	violenceCutsceneActorLine("suit", "npc", "위층에 놈들이 50명이나 있어요. 정말 혼자 가실 겁니까?")
	violenceCutsceneActorLine("rooster", "richard", "혼자가 아니지. 네가 문을 열어.")
	violenceCutsceneActorLine("suit", "npc", "...알겠습니다. 행운을 빌죠.")
	violenceCutsceneNarration("richard", "YOU THINK THIS IS A DREAM? WELL THEN, MAYBE IT'S TIME TO WAKE UP?")
